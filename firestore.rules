rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yardımcı güvenlik fonksiyonları
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'suleymankara600@gmail.com' ||
        (request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Kullanıcıya özel profil, ayarlar ve takipler
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subCollection}/{documentId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Merkezi Takip Edilen Kaynaklar Havuzu (Sources)
    match /sources/{sourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tarama ve Sağlık Günlükleri (Scan Logs)
    match /scan_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Tespit Edilen Fırsatlar ve Etkinlikler Havuzu (Opportunities)
    match /opportunities/{opportunityId} {
      allow read: if isAuthenticated();
      allow write: if false; // Yalnızca Cloud Functions / Admin SDK yazar
    }

    // Sistem Ayarları (Tarayıcı sıklığı vb.)
    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Genel Küratörlü Fırsat Kataloğu (Okuma herkese açık, yazma istemcilere kapalı)
    match /catalog/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // Topluluk Aday Öneri Havuzu (Giriş yapmış her kullanıcı yeni kanal önerebilir)
    match /candidatePool/{candidateId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
