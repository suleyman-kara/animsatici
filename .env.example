# ── Site (Vercel → Settings → Environment Variables; yerelde .env.local) ──
# Sitenin kalıcı adresi (MCP adresi, sitemap ve OG linkleri için)
NEXT_PUBLIC_SITE_URL=https://kampus30.com
# Hakkında/Gizlilik sayfalarında görünen iletişim adresi (boşsa gösterilmez)
CONTACT_EMAIL=

# Fine-grained GitHub token (yalnızca bu repoda "Issues: write"):
# öneri formu issue açar, get_github_projects aracı API kotası için kullanır
GITHUB_TOKEN=
GITHUB_REPO=suleyman-kara/kampus30

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami analitik (boşsa analitik script'i eklenmez)
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
