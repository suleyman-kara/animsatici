# ── Tarayıcı ve ajan (GitHub Actions Secrets/Variables; yerelde .env.local) ──
# Gemini API anahtarı: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# İsteğe bağlı model adı (varsayılan: gemini-3.6-flash)
GEMINI_MODEL=

# ── Site (Vercel → Settings → Environment Variables) ──
# Sitenin kalıcı adresi (sitemap, takvim, OG linkleri için)
NEXT_PUBLIC_SITE_URL=https://kampus30.vercel.app
# Hakkında/Gizlilik sayfalarında görünen iletişim adresi (boşsa gösterilmez)
CONTACT_EMAIL=

# Öneri formu: yalnızca bu repoda "Issues: write" izni olan fine-grained GitHub token
GITHUB_TOKEN=
GITHUB_REPO=suleyman-kara/kampus30
# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Umami analitik (boşsa analitik script'i eklenmez)
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Geliştirme: siteyi örnek veriyle çalıştırmak için
# DATA_ROOT=tests/fixtures/sample-data
